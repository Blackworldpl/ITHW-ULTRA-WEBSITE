# Uzupełnij własne dane. Nie zapisuj rzeczywistego .env w repozytorium.
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://ithardware:CHANGE_ME@127.0.0.1:5432/ithardware
# Opcjonalne osobne konto właściciela schematu używane tylko przez migracje.
MIGRATION_DATABASE_URL=
APP_URL=http://localhost:3000
# Firmowy link HTTPS; pusty oznacza brak konfiguracji.
SERVICENOW_URL=
# Dostępność inicjalizacji pierwszego administratora przez stronę /setup.
# Wygeneruj losową wartość (co najmniej 32 znaki); usuń po utworzeniu konta.
SETUP_TOKEN=
# Lokalny start PostgreSQL używa własnego katalogu poza OneDrive i losowego hasła.
LOCAL_PG_PORT=55432
# Domyślnie %LOCALAPPDATA%\IT-Hardware\postgres; wyłącznie do rozwoju.
LOCAL_PG_DATA=
